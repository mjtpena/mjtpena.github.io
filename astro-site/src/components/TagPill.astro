---
interface Props {
  tag: string;
  href?: string;
  size?: 'sm' | 'md';
}

const { tag, href, size = 'sm' } = Astro.props;

const sizeClasses = {
  sm: 'text-xs px-2.5 py-1',
  md: 'text-sm px-3 py-1.5',
};

const baseClasses = `tag ${sizeClasses[size]}`;
---

{href ? (
  <a href={href} class={baseClasses}>
    {tag}
  </a>
) : (
  <span class={baseClasses}>
    {tag}
  </span>
)}

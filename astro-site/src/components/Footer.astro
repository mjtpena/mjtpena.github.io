const currentYear = new Date().getFullYear();
---

<footer class="border-t border-zinc-800 mt-16 md:mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8 md:py-12">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 sm:gap-6">
      <!-- Contact -->
      <div class="flex items-center gap-3 sm:gap-4">
        <span class="text-zinc-500 text-sm">Contact:</span>
        <a href="mailto:michael@datachain.consulting" class="text-[#00B7C3] hover:text-[#0078D4] transition-colors text-sm break-all">
          michael@datachain.consulting
        </a>
      </div>

      <!-- Social -->
      <div class="flex items-center gap-2 sm:gap-3">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="w-11 h-11 rounded-lg bg-zinc-800 border border-zinc-700 flex items-center justify-center text-zinc-400 hover:text-[#00B7C3] hover:border-[#00B7C3]/30 transition-all duration-300"
            aria-label={link.name}
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <Fragment set:html={link.icon} />
            </svg>
          </a>
        ))}
      </div>

      <!-- Copyright -->
      <p class="text-zinc-600 text-sm">
        &copy; {currentYear}
      </p>
    </div>
  </div>
</footer>

---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, buildTagIndex, readingTime, postDescription, tagHref, pageWindow, type Post } from '../../utils/posts';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getPublishedPosts();
  const topTags = buildTagIndex(posts).slice(0, 16).map(({ name, posts }) => ({ name, count: posts.length }));
  return paginate(posts, { pageSize: 24, props: { topTags } });
};

type Props = { page: Page<Post>; topTags: { name: string; count: number }[] };
const { page, topTags } = Astro.props as Props;

const pagePosts = page.data.map((post) => ({
  post,
  minutes: readingTime(post.body),
}));

const featuredPost = page.currentPage === 1 ? pagePosts[0] : undefined;
const listPosts = page.currentPage === 1 ? pagePosts.slice(1) : pagePosts;
const pageNumbers = pageWindow(page.currentPage, page.lastPage);
const getPageHref = (pageNumber: number) => (pageNumber === 1 ? '/blog' : `/blog/${pageNumber}`);
---


<BaseLayout
  title={page.currentPage === 1 ? 'Blog' : `Blog — Page ${page.currentPage}`}
  description={`Thoughts on data engineering, cloud architecture, and technology. ${page.total} articles.`}
>
  <section class="pt-20 pb-12 md:pt-28 md:pb-20 px-4 sm:px-6">
    <div class="max-w-7xl mx-auto">

      <!-- Header -->
      <header class="mb-10">
        <span class="section-label">
          <span class="glow-dot"></span>
          Articles
        </span>
        <h1 class="section-title">Blog</h1>
        <p class="text-zinc-500 max-w-2xl">
          Thoughts on data engineering, cloud architecture, and technology.
          <span class="font-mono text-zinc-400">{page.total}</span> articles and counting.
        </p>
      </header>

      <!-- Search + topics -->
      <div class="card p-3 sm:p-4 mb-8">
        <div class="flex flex-col lg:flex-row gap-4 items-start lg:items-center">
          <form action="/search" method="get" role="search" class="relative w-full lg:w-72 shrink-0">
            <label for="blog-search" class="sr-only">Search all posts</label>
            <input
              id="blog-search"
              type="search"
              name="q"
              placeholder="Search all posts..."
              class="w-full px-4 py-2.5 pl-10 bg-zinc-800 border border-zinc-700 rounded-lg text-white placeholder-zinc-500 focus:outline-none focus:border-[#0078D4]/50 transition-colors duration-300 text-sm"
            />
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-500 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </form>

          <nav aria-label="Popular topics" class="flex flex-wrap items-center gap-2">
            <span class="text-zinc-500 text-sm font-mono">Topics:</span>
            {topTags.map((tag) => (
              <a href={tagHref(tag.name)} class="tag text-xs">
                {tag.name}<span class="ml-1.5 text-zinc-600">{tag.count}</span>
              </a>
            ))}
            <a href="/blog/tags/" class="text-[#00B7C3] hover:underline text-xs font-mono ml-1">All topics →</a>
          </nav>
        </div>
      </div>

      <!-- Results count -->
      <p class="text-zinc-500 text-sm mb-6 font-mono">
        Showing {page.data.length} of {page.total} posts
        {page.lastPage > 1 && <span>— page {page.currentPage} of {page.lastPage}</span>}
      </p>

      <!-- Posts Grid -->
      <div class="space-y-6">
        {featuredPost && (
          <div>
            <PostCard
              title={featuredPost.post.data.title}
              description={postDescription(featuredPost.post)}
              date={featuredPost.post.data.date}
              slug={featuredPost.post.slug}
              tags={featuredPost.post.data.tags}
              image={featuredPost.post.data.image || featuredPost.post.data.cover}
              featured={true}
              readingTime={featuredPost.minutes}
            />
          </div>
        )}

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {listPosts.map(({ post, minutes }) => (
            <div>
              <PostCard
                title={post.data.title}
                description={postDescription(post)}
                date={post.data.date}
                slug={post.slug}
                tags={post.data.tags}
                image={post.data.image || post.data.cover}
                readingTime={minutes}
              />
            </div>
          ))}
        </div>
      </div>

      <!-- Pagination -->
      {page.lastPage > 1 && (
        <nav class="mt-12 flex items-center justify-between" aria-label="Blog pagination">
          <div>
            {page.url.prev ? (
              <a href={page.url.prev} class="btn-secondary flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                Newer posts
              </a>
            ) : (
              <span></span>
            )}
          </div>

          <div class="flex items-center gap-1">
            {pageNumbers.map((pageNumber) =>
              pageNumber === null ? (
                <span class="w-8 h-8 inline-flex items-center justify-center text-xs font-mono text-zinc-600" aria-hidden="true">…</span>
              ) : (
                <a
                  href={getPageHref(pageNumber)}
                  class:list={[
                    'w-8 h-8 inline-flex items-center justify-center rounded-md text-xs font-mono transition-colors duration-300',
                    pageNumber === page.currentPage
                      ? 'bg-[#0078D4] text-white'
                      : 'text-zinc-400 hover:text-white hover:bg-zinc-800',
                  ]}
                  aria-current={pageNumber === page.currentPage ? 'page' : undefined}
                  aria-label={`Page ${pageNumber}`}
                >
                  {pageNumber}
                </a>
              )
            )}
          </div>

          <div>
            {page.url.next ? (
              <a href={page.url.next} class="btn-secondary flex items-center gap-2">
                Older posts
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            ) : (
              <span></span>
            )}
          </div>
        </nav>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  // Old tag links were /blog?tag=Name; forward them to the static tag page.
  const legacyTag = new URLSearchParams(window.location.search).get('tag');
  if (legacyTag) {
    const slug = legacyTag
      .toLowerCase()
      .replace(/^\./, 'dot')
      .replace(/#/g, '-sharp')
      .replace(/\+/g, '-plus')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');
    if (slug) window.location.replace(`/blog/tag/${slug}/`);
  }
</script>

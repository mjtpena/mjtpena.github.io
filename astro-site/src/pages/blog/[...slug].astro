---
import type { CollectionEntry } from 'astro:content';
import { getPublishedPosts } from '../../utils/posts';
import PostLayout from '../../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const sortedPosts = await getPublishedPosts();

  return sortedPosts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      prevPost: sortedPosts[index + 1] ?? null,
      nextPost: sortedPosts[index - 1] ?? null,
    },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  prevPost: CollectionEntry<'blog'> | null;
  nextPost: CollectionEntry<'blog'> | null;
}

const { post, prevPost, nextPost } = Astro.props as Props;
const { Content, headings } = await post.render();
---

<PostLayout post={post} prevPost={prevPost} nextPost={nextPost} headings={headings}>
  <Content />
</PostLayout>

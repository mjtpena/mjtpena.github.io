---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPublishedPosts, buildTagIndex, readingTime, postDescription, type TagInfo } from '../../../utils/posts';

export const getStaticPaths: GetStaticPaths = async () => {
  const tags = buildTagIndex(await getPublishedPosts());
  return tags.map((tag) => ({ params: { tag: tag.slug }, props: { tag } }));
};

const { tag } = Astro.props as { tag: TagInfo };
const count = tag.posts.length;
// Tags used only once or twice make thin pages; keep them browsable but out of search indexes.
const noindex = count < 3;
---

<BaseLayout
  title={`${tag.name} articles`}
  description={`${count} article${count === 1 ? '' : 's'} by Michael John Peña about ${tag.name}.`}
  noindex={noindex}
>
  <section class="pt-20 pb-12 md:pt-28 md:pb-20 px-4 sm:px-6">
    <div class="max-w-7xl mx-auto">
      <header class="mb-10">
        <a href="/blog/tags/" class="inline-flex items-center gap-2 text-zinc-500 hover:text-[#00B7C3] transition-colors duration-300 mb-6 text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7" />
          </svg>
          All topics
        </a>
        <span class="section-label">
          <span class="glow-dot"></span>
          Topic
        </span>
        <h1 class="section-title">{tag.name}</h1>
        <p class="text-zinc-500 font-mono text-sm">{count} article{count === 1 ? '' : 's'}</p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {tag.posts.map((post) => (
          <PostCard
            title={post.data.title}
            description={postDescription(post)}
            date={post.data.date}
            slug={post.slug}
            tags={post.data.tags}
            image={post.data.image || post.data.cover}
            readingTime={readingTime(post.body)}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page Not Found">
  <section class="min-h-screen flex items-center justify-center px-4 py-20">
    <div class="max-w-lg mx-auto text-center">
      <!-- Glowing 404 -->
      <div class="relative mb-8">
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="w-48 h-48 bg-[#0078D4]/10 rounded-full blur-3xl"></div>
        </div>
        <div class="relative font-display font-bold text-[120px] leading-none text-transparent bg-clip-text bg-gradient-to-br from-[#0078D4] via-[#00B7C3] to-[#50E6FF]">
          404
        </div>
      </div>

      <!-- Message -->
      <div class="card p-0 overflow-hidden mb-8">
        <div class="flex items-center gap-2 px-4 py-3 bg-zinc-900/90 border-b border-zinc-800">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
          </div>
          <span class="text-xs text-zinc-500 font-mono ml-2">error.log</span>
        </div>
        <div class="p-6 font-mono text-sm space-y-2 text-left">
          <div class="flex gap-2">
            <span class="text-red-400">ERROR</span>
            <span class="text-zinc-400">Page not found at this path</span>
          </div>
          <div class="flex gap-2">
            <span class="text-zinc-600">INFO</span>
            <span class="text-zinc-500">The data pipeline for this URL returned null</span>
          </div>
          <div class="flex gap-2">
            <span class="text-[#00B7C3]">HINT</span>
            <span class="text-zinc-400">Try one of the routes below</span>
          </div>
        </div>
      </div>

      <!-- Nav options -->
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/" class="btn-primary">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Home
        </a>
        <a href="/blog" class="btn-secondary">Blog</a>
        <a href="/projects" class="btn-secondary">Projects</a>
        <a href="/talks" class="btn-secondary">Talks</a>
      </div>
    </div>
  </section>
</BaseLayout>
